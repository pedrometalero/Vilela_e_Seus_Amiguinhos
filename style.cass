/* Variáveis de Cores (Tema Padrão Científico) */
:root {
    --bg-principal: #f0f4f8;
    --bg-card: #ffffff;
    --cor-texto: #1e293b;
    --cor-primaria: #0f4c81;
    --cor-destaque: #0284c7;
    --borda-card: #cbd5e1;
    --bg-acessibilidade: #0a365c;
    --texto-claro: #ffffff;
}

/* Variáveis de Cores (Modo Alto Contraste) */
body.alto-contraste {
    --bg-principal: #000000;
    --bg-card: #000000;
    --cor-texto: #ffff00; /* Amarelo vivo para leitura */
    --cor-primaria: #000000;
    --cor-destaque: #00ffff; /* Ciano para destaques */
    --borda-card: #ffff00;
    --bg-acessibilidade: #1a1a1a;
    --texto-claro: #ffff00;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--bg-principal);
    color: var(--cor-texto);
    line-height: 1.6;
    transition: background-color 0.3s, color 0.3s;
}

.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Barra de Acessibilidade */
.barra-acessibilidade {
    background-color: var(--bg-acessibilidade);
    color: var(--texto-claro);
    padding: 10px 20px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    border-bottom: 2px solid var(--cor-destaque);
}

.barra-acessibilidade span {
    font-size: 0.9rem;
    font-weight: bold;
}

.barra-acessibilidade button {
    background-color: var(--bg-card);
    color: var(--cor-texto);
    border: 2px solid var(--cor-destaque);
    padding: 5px 12px;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.9rem;
    transition: transform 0.1s;
}

.barra-acessibilidade button:hover,
.barra-acessibilidade button:focus {
    outline: 3px solid var(--cor-destaque);
    transform: scale(1.05);
}

/* Cabeçalho */
header {
    background-color: var(--cor-primaria);
    color: var(--texto-claro);
    padding: 50px 0;
    text-align: center;
    border-bottom: 4px solid var(--cor-destaque);
}

header h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

header p {
    font-size: 1.2rem;
    opacity: 0.9;
}

/* Conteúdo Principal */
main {
    padding: 40px 0;
}

.introducao {
    background-color: var(--bg-card);
    padding: 25px;
    border-radius: 8px;
    border: 1px solid var(--borda-card);
    margin-bottom: 40px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

.introducao h2 {
    color: var(--cor-destaque);
    margin-bottom: 10px;
}

/* Cards dos Modelos Atômicos */
.timeline {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

.card {
    background-color: var(--bg-card);
    border: 2px solid var(--borda-card);
    border-left: 8px solid var(--cor-destaque);
    border-radius: 8px;
    padding: 25px;
    position: relative;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
}

.card .ano {
    display: inline-block;
    background-color: var(--cor-destaque);
    color: #000000;
    font-weight: bold;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.9rem;
    margin-bottom: 10px;
}

.card h3 {
    font-size: 1.5rem;
    margin-bottom: 10px;
    color: var(--cor-destaque);
}

/* Rodapé */
footer {
    background-color: var(--cor-primaria);
    color: var(--texto-claro);
    text-align: center;
    padding: 20px 0;
    margin-top: 40px;
    border-top: 2px solid var(--cor-destaque);
}

/* Responsividade */
@media (max-width: 600px) {
    header h1 {
        font-size: 1.8rem;
    }
    .barra-acessibilidade {
        justify-content: center;
    }
}
