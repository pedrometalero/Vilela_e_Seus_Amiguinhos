/* Variáveis de Cores (Tema Moderno Científico) */
:root {
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-main: #f8fafc;
    --text-muted: #cbd5e1;
    --accent: #38bdf8;
    --accent-hover: #0284c7;
    --border-color: #334155;
}

/* Tema de Alto Contraste (Acessibilidade) */
body.alto-contraste {
    --bg-color: #000000;
    --card-bg: #000000;
    --text-main: #ffffff;
    --text-muted: #ffff00;
    --accent: #00ffff;
    --accent-hover: #ffff00;
    --border-color: #ffffff;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    font-size: 100%;
}

body {
    font-family: 'Poppins', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    line-height: 1.6;
    transition: background-color 0.3s, color 0.3s;
}

.container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Barra de Acessibilidade */
.acessibilidade-bar {
    position: fixed;
    top: 20px;
    right: 20px;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
}

#btn-acessibilidade {
    background-color: var(--accent);
    color: #0f172a;
    border: 2px solid transparent;
    padding: 10px 16px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s;
}

#btn-acessibilidade:hover,
#btn-acessibilidade:focus {
    transform: scale(1.05);
    outline: 3px solid #ffffff;
}

.painel-oculto {
    display: none;
    flex-direction: column;
    gap: 8px;
    margin-top: 10px;
    background-color: var(--card-bg);
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
}

.painel-visivel {
    display: flex;
}

.painel-oculto button {
    background-color: transparent;
    color: var(--text-main);
    border: 1px solid var(--border-color);
    padding: 8px 12px;
    border-radius: 8px;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    font-size: 0.9rem;
    transition: background-color 0.2s;
}

.painel-oculto button:hover,
.painel-oculto button:focus {
    background-color: var(--accent);
    color: #000000;
    font-weight: 600;
}

/* Cabeçalho Hero */
.hero {
    text-align: center;
    padding: 100px 20px 80px;
    background: radial-gradient(circle at top, #1e293b 0%, var(--bg-color) 70%);
    border-bottom: 1px solid var(--border-color);
}

.badge {
    display: inline-block;
    background-color: rgba(56, 189, 248, 0.15);
    color: var(--accent);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 16px;
    border: 1px solid var(--accent);
}

.hero h1 {
    font-size: 2.8rem;
    margin-bottom: 16px;
    line-height: 1.2;
}

.hero p {
    max-width: 650px;
    margin: 0 auto 30px;
    color: var(--text-muted);
    font-size: 1.1rem;
}

.btn-primary {
    display: inline-block;
    background-color: var(--accent);
    color: #0f172a;
    text-decoration: none;
    padding: 12px 28px;
    border-radius: 8px;
    font-weight: 600;
    transition: background-color 0.3s;
}

.btn-primary:hover {
    background-color: var(--accent-hover);
    color: #ffffff;
}

/* Cards dos Modelos Atômicos */
main {
    padding: 60px 20px;
    display: flex;
    flex-direction: column;
    gap: 40px;
}

.card {
    display: flex;
    align-items: center;
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 30px;
    gap: 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

.card-img {
    flex: 0 0 180px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(15, 23, 42, 0.5);
    border-radius: 12px;
    padding: 15px;
    border: 1px solid var(--border-color);
}

.card-img svg {
    width: 150px;
    height: 150px;
}

.card-content .ano {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.card-content h2 {
    font-size: 1.8rem;
    margin: 6px 0 12px;
}

.card-content p {
    color: var(--text-muted);
    margin-bottom: 16px;
}

.card-content ul {
    padding-left: 20px;
    color: var(--text-main);
}

.card-content li {
    margin-bottom: 6px;
}

/* Rodapé */
footer {
    text-align: center;
    padding: 30px 20px;
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* Responsividade para Celulares */
@media (max-width: 768px) {
    .hero h1 {
        font-size: 2rem;
    }

    .card {
        flex-direction: column;
        text-align: center;
    }

    .card-content ul {
        text-align: left;
    }
}
