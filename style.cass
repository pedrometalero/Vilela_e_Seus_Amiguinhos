/* Variáveis de Cores (Tema Padrão) */
:root {
    --cor-fundo: #f4f6f9;
    --cor-card: #ffffff;
    --cor-texto: #1e293b;
    --cor-primaria: #0f4c81;
    --cor-primaria-escura: #093154;
    --cor-borda: #cbd5e1;
    --cor-foco: #f59e0b;
}

/* Variáveis de Cores (Tema Alto Contraste) */
body.alto-contraste {
    --cor-fundo: #000000;
    --cor-card: #000000;
    --cor-texto: #ffffff;
    --cor-primaria: #ffff00;
    --cor-primaria-escura: #000000;
    --cor-borda: #ffff00;
    --cor-foco: #00ffff;
}

/* Reset Básico */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 100%; /* Facilita o redimensionamento via rem */
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--cor-fundo);
    color: var(--cor-texto);
    line-height: 1.6;
    transition: background-color 0.2s, color 0.2s;
}

/* Foco visível para navegação via teclado */
:focus-visible {
    outline: 3px solid var(--cor-foco);
    outline-offset: 3px;
}

/* Link de salto acessível */
.skip-link {
    position: absolute;
    top: -50px;
    left: 10px;
    background: var(--cor-primaria);
    color: #fff;
    padding: 10px 15px;
    z-index: 1000;
    text-decoration: none;
    font-weight: bold;
    border-radius: 4px;
}

.skip-link:focus {
    top: 10px;
}

body.alto-contraste .skip-link {
    background: #ffff00;
    color: #000000;
}

/* Container padrão */
.container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Barra de Acessibilidade */
.barra-acessibilidade {
    background-color: var(--cor-primaria-escura);
    color: #ffffff;
    padding: 10px 0;
    border-bottom: 1px solid var(--cor-borda);
}

.barra-acessibilidade .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    justify-content: flex-end;
}

.barra-acessibilidade span {
    font-size: 0.9rem;
    font-weight: bold;
    margin-right: 5px;
}

.barra-acessibilidade button {
    background-color: #ffffff;
    color: #0f4c81;
    border: 2px solid transparent;
    padding: 5px 12px;
    font-size: 0.9rem;
    font-weight: bold;
    border-radius: 4px;
    cursor: pointer;
}

.barra-acessibilidade button:hover {
    background-color: #e2e8f0;
}

body.alto-contraste .barra-acessibilidade button {
    background-color: #000000;
    color: #ffff00;
    border: 2px solid #ffff00;
}

body.alto-contraste .barra-acessibilidade button:hover {
    background-color: #ffff00;
    color: #000000;
}

/* Cabeçalho */
.cabecalho {
    background-color: var(--cor-primaria);
    color: #ffffff;
    padding: 30px 0;
    text-align: center;
    border-bottom: 2px solid var(--cor-borda);
}

body.alto-contraste .cabecalho {
    background-color: #000000;
    color: #ffff00;
}

.cabecalho h1 {
    font-size: 2.2rem;
    margin-bottom: 10px;
}

.cabecalho p {
    font-size: 1.1rem;
    margin-bottom: 20px;
}

/* Menu de Navegação */
.menu-navegacao {
    list-style: none;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 15px;
}

.menu-navegacao a {
    color: #ffffff;
    text-decoration: none;
    font-weight: bold;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 20px;
    display: inline-block;
}

.menu-navegacao a:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

body.alto-contraste .menu-navegacao a {
    color: #ffff00;
    border-color: #ffff00;
}

body.alto-contraste .menu-navegacao a:hover {
    background-color: #ffff00;
    color: #000000;
}

/* Cards dos Modelos Atômicos */
main {
    padding: 30px 0;
}

.card-modelo {
    background-color: var(--cor-card);
    border: 1px solid var(--cor-borda);
    border-radius: 8px;
    padding: 25px;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
}

.texto-modelo {
    flex: 1;
}

.texto-modelo h2 {
    color: var(--cor-primaria);
    font-size: 1.5rem;
    margin-bottom: 12px;
}

.texto-modelo p {
    margin-bottom: 12px;
    font-size: 1rem;
}

.texto-modelo ul {
    margin-left: 20px;
}

.texto-modelo li {
    margin-bottom: 6px;
}

/* Imagens controladas para não ficarem grandes */
.imagem-modelo {
    flex-shrink: 0;
    width: 180px;
    text-align: center;
    background-color: #ffffff; /* Mantém fundo claro para transparência dos SVGs no modo alto contraste */
    padding: 10px;
    border-radius: 6px;
    border: 1px solid var(--cor-borda);
}

.imagem-modelo img {
    width: 140px;
    height: 140px;
    object-fit: contain;
    display: block;
    margin: 0 auto;
}

.imagem-modelo figcaption {
    font-size: 0.8rem;
    color: #333333;
    margin-top: 8px;
}

/* Rodapé */
.rodape {
    background-color: var(--cor-primaria-escura);
    color: #ffffff;
    text-align: center;
    padding: 20px 0;
    border-top: 1px solid var(--cor-borda);
    font-size: 0.95rem;
}

body.alto-contraste .rodape {
    color: #ffff00;
}

/* Responsividade para celulares */
@media (max-width: 700px) {
    .card-modelo {
        flex-direction: column;
        text-align: left;
    }

    .imagem-modelo {
        width: 100%;
        max-width: 220px;
        margin: 0 auto;
    }
}
