/* Variáveis de Cores (Tema Padrão) */
:root {
    --bg-body: #f4f6f9;
    --bg-card: #ffffff;
    --bg-header: #1e3a8a;
    --bg-barra: #0f172a;
    --texto-principal: #1e293b;
    --texto-claro: #ffffff;
    --destaque: #2563eb;
    --borda: #cbd5e1;
    --foco: #f59e0b;
}

/* Tema de Alto Contraste */
body.alto-contraste {
    --bg-body: #000000;
    --bg-card: #000000;
    --bg-header: #000000;
    --bg-barra: #111111;
    --texto-principal: #ffffff;
    --texto-claro: #ffff00;
    --destaque: #ffff00;
    --borda: #ffff00;
    --foco: #00ffff;
}

/* Reset e Base */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 100%;
    scroll-behavior: smooth;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: var(--bg-body);
    color: var(--texto-principal);
    line-height: 1.6;
    transition: background-color 0.2s, color 0.2s;
}

/* Modo Fonte Legível (Auxílio para Dislexia e Baixa Visão) */
body.fonte-legivel {
    font-family: 'Comic Sans MS', 'OpenDyslexic', Arial, sans-serif;
    letter-spacing: 0.08em;
    word-spacing: 0.16em;
    line-height: 1.9;
}

/* Foco visível para navegação via teclado */
a:focus, button:focus {
    outline: 3px solid var(--foco);
    outline-offset: 3px;
}

/* Skip Link (Pular para o conteúdo) */
.skip-link {
    position: absolute;
    top: -50px;
    left: 10px;
    background: var(--foco);
    color: #000;
    padding: 10px 15px;
    font-weight: bold;
    z-index: 1000;
    text-decoration: none;
    border-radius: 4px;
}

.skip-link:focus {
    top: 10px;
}

/* Container padrão */
.container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Barra de Acessibilidade */
.barra-acessibilidade {
    background-color: var(--bg-barra);
    color: #ffffff;
    padding: 10px 0;
    border-bottom: 2px solid var(--borda);
    position: sticky;
    top: 0;
    z-index: 999;
}

.barra-acessibilidade .container {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
}

.barra-acessibilidade span {
    font-weight: bold;
    margin-right: 5px;
}

.barra-acessibilidade button {
    background-color: #ffffff;
    color: #0f172a;
    border: 2px solid transparent;
    padding: 6px 12px;
    border-radius: 5px;
    font-weight: bold;
    cursor: pointer;
    font-size: 0.9rem;
}

.barra-acessibilidade button:hover {
    background-color: #e2e8f0;
}

body.alto-contraste .barra-acessibilidade button {
    background-color: #000000;
    color: #ffff00;
    border: 2px solid #ffff00;
}

body.alto-contraste .barra-acessibilidade button[aria-pressed="true"] {
    background-color: #ffff00;
    color: #000000;
}

/* Cabeçalho */
header {
    background-color: var(--bg-header);
    color: var(--texto-claro);
    padding: 40px 0 25px;
    text-align: center;
    border-bottom: 3px solid var(--borda);
}

header h1 {
    font-size: 2.2rem;
    margin-bottom: 10px;
}

header p {
    font-size: 1.1rem;
    margin-bottom: 25px;
}

nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
}

nav a {
    color: var(--texto-claro);
    text-decoration: none;
    font-weight: bold;
    padding: 8px 16px;
    border: 2px solid var(--texto-claro);
    border-radius: 20px;
    display: inline-block;
}

nav a:hover {
    background-color: var(--texto-claro);
    color: var(--bg-header);
}

/* Conteúdo Principal */
main {
    padding: 40px 20px;
}

.introducao {
    background-color: var(--bg-card);
    padding: 25px;
    border-radius: 10px;
    border: 2px solid var(--borda);
    margin-bottom: 30px;
}

.introducao h2 {
    color: var(--destaque);
    margin-bottom: 10px;
}

/* Cards dos Modelos Atômicos */
.card-modelo {
    background-color: var(--bg-card);
    border: 2px solid var(--borda);
    border-radius: 10px;
    padding: 25px;
    margin-bottom: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 25px;
}

.texto-modelo {
    flex: 1 1 55%;
}

.texto-modelo h2 {
    color: var(--destaque);
    margin-bottom: 12px;
    font-size: 1.5rem;
}

.texto-modelo p {
    margin-bottom: 12px;
}

.texto-modelo ul {
    margin-left: 20px;
}

.texto-modelo li {
    margin-bottom: 8px;
}

.imagem-modelo {
    flex: 1 1 35%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: rgba(148, 163, 184, 0.1);
    padding: 15px;
    border-radius: 8px;
    border: 1px solid var(--borda);
}

.imagem-modelo svg {
    width: 180px;
    height: 180px;
    color: var(--texto-principal);
}

.legenda {
    margin-top: 10px;
    font-size: 0.85rem;
    text-align: center;
    font-style: italic;
}

/* Rodapé */
footer {
    background-color: var(--bg-header);
    color: var(--texto-claro);
    text-align: center;
    padding: 20px 0;
    border-top: 3px solid var(--borda);
    margin-top: 40px;
}

/* Responsividade */
@media (max-width: 768px) {
    .card-modelo {
        flex-direction: column;
    }

    .texto-modelo, .imagem-modelo {
        width: 100%;
    }
}
