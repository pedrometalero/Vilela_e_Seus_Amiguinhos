/* Variáveis de Cores (Tema Padrão) */
:root {
    --bg-pagina: #f8fafc;
    --bg-card: #ffffff;
    --bg-barra: #0f172a;
    --texto-principal: #1e293b;
    --texto-secundario: #475569;
    --texto-inverso: #ffffff;
    --destaque: #2563eb;
    --destaque-hover: #1d4ed8;
    --borda: #cbd5e1;
    --foco-outline: #f59e0b;

    /* Cores dos Átomos */
    --cor-proton: #ef4444;
    --cor-neutron: #64748b;
    --cor-eletron: #2563eb;
    --cor-orbita: #94a3b8;
    --cor-esfera: #3b82f6;
}

/* Tema de Alto Contraste (Ativado via Botão) */
body.alto-contraste {
    --bg-pagina: #000000;
    --bg-card: #000000;
    --bg-barra: #000000;
    --texto-principal: #ffffff;
    --texto-secundario: #ffff00;
    --texto-inverso: #ffff00;
    --destaque: #ffff00;
    --destaque-hover: #00ffff;
    --borda: #ffffff;
    --foco-outline: #00ffff;

    /* Cores dos Átomos em Alto Contraste */
    --cor-proton: #ff5555;
    --cor-neutron: #ffffff;
    --cor-eletron: #00ffff;
    --cor-orbita: #ffff00;
    --cor-esfera: #ffff00;
}

/* Espaçamento Ampliado para Facilidade de Leitura */
body.espacamento-amplo {
    line-height: 1.9 !important;
    letter-spacing: 0.06em !important;
    word-spacing: 0.14em !important;
}

/* Reset e Base */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    font-size: 100%;
    scroll-behavior: smooth;
}

body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-pagina);
    color: var(--texto-principal);
    line-height: 1.6;
    transition: background-color 0.2s, color 0.2s;
}

/* Indicador de Foco Visível para Navegação por Teclado */
:focus-visible {
    outline: 3px solid var(--foco-outline);
    outline-offset: 3px;
}

/* Link de Pular para Conteúdo */
.skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    background: var(--destaque);
    color: var(--texto-inverso);
    padding: 0.75rem 1rem;
    z-index: 1000;
    font-weight: bold;
    border-radius: 4px;
    text-decoration: none;
}

.skip-link:focus {
    top: 1rem;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: 0 auto;
}

/* Barra de Acessibilidade */
.acessibilidade-bar {
    background-color: var(--bg-barra);
    color: var(--texto-inverso);
    padding: 0.6rem 0;
    border-bottom: 2px solid var(--borda);
    position: sticky;
    top: 0;
    z-index: 100;
}

.flex-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
}

.controles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
}

.controles button {
    background-color: transparent;
    color: var(--texto-inverso);
    border: 2px solid var(--texto-inverso);
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
}

.controles button:hover,
.controles button[aria-pressed="true"] {
    background-color: var(--destaque);
    color: #000000;
    border-color: var(--destaque);
}

/* Cabeçalho */
.navbar {
    padding: 2.5rem 0 1.5rem;
    border-bottom: 2px solid var(--borda);
    margin-bottom: 2rem;
}

.navbar h1 {
    font-size: 2.2rem;
    line-height: 1.2;
}

.subtitulo {
    color: var(--texto-secundario);
    font-size: 1.15rem;
    margin-top: 0.3rem;
}

/* Seção Hero e Imagem Grande */
.hero-section,
.quantico-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: center;
    background-color: var(--bg-card);
    border: 2px solid var(--borda);
    border-radius: 12px;
    padding: 1.8rem;
    margin-bottom: 3rem;
}

.hero-texto h2,
.quantico-texto h2 {
    font-size: 1.6rem;
    margin-bottom: 0.8rem;
}

.hero-texto p,
.quantico-texto p {
    margin-bottom: 1rem;
}

.imagem-grande-box {
    background-color: var(--bg-pagina);
    border: 2px solid var(--borda);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
}

.svg-grande {
    width: 100%;
    max-width: 380px;
    height: auto;
    display: block;
    margin: 0 auto;
}

figcaption {
    font-size: 0.9rem;
    color: var(--texto-secundario);
    margin-top: 0.6rem;
}

/* Grade de Cartões (Imagens Pequenas) */
.secao-titulo {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
}

.grid-modelos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
}

.card {
    background-color: var(--bg-card);
    border: 2px solid var(--borda);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.btn-ampliar {
    background-color: var(--bg-pagina);
    border: none;
    border-bottom: 2px solid var(--borda);
    padding: 1.2rem;
    cursor: pointer;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
}

.btn-ampliar:hover {
    background-color: rgba(37, 99, 235, 0.08);
}

.svg-pequeno {
    width: 110px;
    height: 110px;
}

.zoom-tag {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--destaque);
}

.card-body {
    padding: 1.25rem;
}

.ano {
    display: inline-block;
    background-color: var(--destaque);
    color: var(--texto-inverso);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.5rem;
}

body.alto-contraste .ano {
    color: #000000;
}

.card-body h3 {
    font-size: 1.3rem;
}

.card-body h4 {
    font-size: 1rem;
    color: var(--texto-secundario);
    margin-bottom: 0.6rem;
}

/* Estilização dos Elementos Vetoriais (Átomos) */
.orbita {
    fill: none;
    stroke: var(--cor-orbita);
    stroke-width: 2;
}

.proton {
    fill: var(--cor-proton);
}

.neutron {
    fill: var(--cor-neutron);
}

.eletron {
    fill: var(--cor-eletron);
}

.esfera-solida,
.esfera-positiva {
    fill: var(--cor-esfera);
}

.sinal-mais {
    fill: #ffffff;
    font-weight: bold;
    font-size: 20px;
}

body.alto-contraste .sinal-mais {
    fill: #000000;
}

/* Modal de Ampliação */
dialog {
    margin: auto;
    border: 3px solid var(--borda);
    border-radius: 12px;
    background-color: var(--bg-card);
    color: var(--texto-principal);
    padding: 1.5rem;
    width: 90%;
    max-width: 500px;
}

dialog::backdrop {
    background: rgba(0, 0, 0, 0.75);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--borda);
    padding-bottom: 0.5rem;
}

#btn-fechar-modal {
    background-color: var(--destaque);
    color: var(--texto-inverso);
    border: none;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
}

body.alto-contraste #btn-fechar-modal {
    color: #000000;
}

.svg-modal {
    width: 100%;
    max-width: 320px;
    height: auto;
    display: block;
    margin: 0 auto;
}

/* Rodapé */
.footer {
    border-top: 2px solid var(--borda);
    padding: 1.5rem 0;
    text-align: center;
    color: var(--texto-secundario);
}

/* Responsividade */
@media (max-width: 768px) {
    .hero-section,
    .quantico-section {
        grid-template-columns: 1fr;
    }
}
